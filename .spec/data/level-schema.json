{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BattleCityLevel",
  "type": "object",
  "required": ["id", "name", "grid", "enemyRoster", "spawnPoints", "basePosition", "playerSpawns"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "custom": { "type": "boolean", "default": false },
    "grid": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "array",
        "minItems": 13,
        "maxItems": 13,
        "items": {
          "type": "string",
          "enum": ["empty", "brick", "steel", "water", "ice", "bush"]
        }
      }
    },
    "enemyRoster": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "string",
        "enum": ["basic", "fast", "power", "armor"]
      }
    },
    "spawnPoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["col", "row"],
        "properties": {
          "col": { "type": "integer", "minimum": 0, "maximum": 12 },
          "row": { "type": "integer", "minimum": 0, "maximum": 12 }
        }
      }
    },
    "basePosition": {
      "type": "object",
      "required": ["col", "row"],
      "properties": {
        "col": { "type": "integer", "minimum": 0, "maximum": 11 },
        "row": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "playerSpawns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["col", "row", "player"],
        "properties": {
          "col": { "type": "integer" },
          "row": { "type": "integer" },
          "player": { "type": "integer", "enum": [1, 2] }
        }
      }
    }
  }
}
